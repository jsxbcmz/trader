{
  "templates": [
    {
      "id": "template-close-above-ma5",
      "name": "收盘价高于5日均线",
      "description": "当日收盘价高于 5 日均线。",
      "condition": {
        "kind": "comparison",
        "operator": ">",
        "left": {
          "kind": "field",
          "field": "CLOSE"
        },
        "right": {
          "kind": "function",
          "name": "MA",
          "args": [
            {
              "kind": "field",
              "field": "CLOSE"
            },
            {
              "kind": "constant",
              "value": 5
            }
          ]
        }
      },
      "default_time_mode": "exact",
      "stock_pool_name": "default",
      "include_debug": false,
      "created_at": "",
      "updated_at": ""
    },
    {
      "id": "template-close-above-prev-close",
