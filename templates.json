          "left": {
            "kind": "function",
            "name": "REF",
            "args": [
              {
                "kind": "field",
                "field": "VOLUME"
              },
              {
                "kind": "constant",
                "value": 1
              }
            ]
          },
          "right": {
            "kind": "constant",
            "value": 2
          }
        }
      },
      "default_time_mode": "exact",
      "stock_pool_name": "default",
