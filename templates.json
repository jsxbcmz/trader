        "kind": "comparison",
        "operator": ">",
        "left": {
          "kind": "field",
          "field": "CLOSE"
        },
        "right": {
          "kind": "function",
          "name": "REF",
          "args": [
            {
              "kind": "field",
              "field": "CLOSE"
            },
            {
              "kind": "constant",
              "value": 1
            }
          ]
        }
      },
      "default_time_mode": "exact",
      "stock_pool_name": "default",
