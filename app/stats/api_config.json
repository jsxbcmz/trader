{
  "apis": [
    {
      "name": "比赛排名",
      "url": "https://capital.hexin.cn/caishen_httpserver/direct/caishen_fund/community_share/v1/match_ranking_by_share",
      "method": "GET",
      "headers": {},
      "params": {
        "count": "50",
        "key": "fxDXFko",
        "month": "",
        "sort_type": "daily_profit",
        "sort_order": "1",
        "group_type": "",
        "shouldFillIn": "true",
        "isUseCache": "false",
        "terminal": "1",
        "version": "2",
        "hexin-v": "A-WEyL124Dp3NQTmfKyaaYqH8qoaIpnP49R9COfKovQrOwvUr3KphHMmjdx0"
      },
      "pagination": {
        "enabled": true,
        "page_param": "page",
        "page_size": 50,
        "dynamic_params": {
          "pageRequestId": "_daily_profit_{page}_"
        },
        "data_path": "ex_data.rank_list",
        "metadata_fields": {
          "max_count": "ex_data.max_count",
          "max_page": "ex_data.max_page",
          "match_start": "ex_data.match_start",
          "match_end": "ex_data.match_end",
          "article_title": "ex_data.article_title",
          "owner": "ex_data.owner",
          "status": "ex_data.status"
        },
        "keep_fields": ["user_key"]
      },
      "output_file": "user_keys.json"
    },
    {
      "name": "每日持仓",
      "url": "https://capital.hexin.cn/caishen_httpserver/direct/caishen_fund/community_share/v1/day_position_by_share",
      "method": "GET",
      "headers": {},
      "params": {
        "date": "{today}",
        "terminal": "1",
        "version": "2",
        "delivery_id": "",
        "match_type": "community",
        "key": "fxDXFko",
        "hexin-v": "Azta1qdk1pwV4OooMGOMT1CVzBSgkE-TSaQTRi34FzpRjFXKtWDf4ll0o54-"
      },
      "batch": {
        "enabled": true,
        "param_name": "user_key",
        "source_file": "user_keys.json",
        "source_field": "user_key",
        "data_path": "ex_data.list",
        "merge_mode": "flatten"
      },
      "output_file": "day_positions.json"
    }
  ],
  "settings": {
    "timeout": 30,
    "retry_count": 3,
    "retry_delay": 2,
    "delay_between_requests": 0.3
  }
}
